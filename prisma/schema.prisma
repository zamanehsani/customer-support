

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clients {
  id           String    @id @default(uuid())
  name         String
  email        String   @unique
  phone        String
  address      String?
  city         String?
  state        String?
  zip          String?
  country      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime @updatedAt
  logo         String?
  notes        String?
  users        String?
  departments  String[]
  valid_to     DateTime?
  valid_from   DateTime?
  WhatsApp     String?
  license      String?
  isActive     Boolean   @default(true)
  isSuspensed  Boolean   @default(false)
  logs         Logs[]
}

model Users {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  name      String
  email     String  @unique
  password  String
  roles     String[]
  photo     String?
  document  String?
  phone     String?
}


model Logs {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  user      String
  action    String
  details   String
  userAgent String
  client    Clients @relation(fields: [clientId], references: [id])
  clientId  String
}
